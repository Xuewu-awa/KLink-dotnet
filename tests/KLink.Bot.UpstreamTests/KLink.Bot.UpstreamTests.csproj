<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath Condition="'$(UpstreamSourceRoot)' != ''">$(UpstreamSourceRoot)/tools/BotSim/bin/$(Configuration)/</OutputPath>
  </PropertyGroup>
  <Target Name="RequirePinnedSources" BeforeTargets="CoreCompile">
    <Error Condition="'$(UpstreamSourceRoot)' == ''" Text="Run tests/Run-BotVerification.ps1 to stage the pinned upstream sources." />
  </Target>
  <ItemGroup>
    <Compile Include="$(UpstreamSourceRoot)/Program.cs;$(UpstreamSourceRoot)/SelfTest.cs;$(UpstreamSourceRoot)/DispatchGap.cs;$(UpstreamSourceRoot)/GapReport.cs;$(UpstreamSourceRoot)/SmokeAllCards.cs" />
    <ProjectReference Include="../../KLink.Bot/KLink.Bot.csproj" />
  </ItemGroup>
</Project>
