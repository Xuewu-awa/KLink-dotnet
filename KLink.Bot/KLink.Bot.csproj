<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KLink.Bot</RootNamespace>
    <BotDataRoot Condition="'$(BotDataRoot)' == ''">$(MSBuildThisFileDirectory)..\..\klink bot\klink bot\docs</BotDataRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- 卡牌数据：优先用线上 pak 的 CDO 权威版（tools/gen-card-db.py 生成，覆盖全部线上卡），
         回退到较早的 FModel 导出（缺 34 张线上已有的卡）。 -->
    <None Include="$(BotDataRoot)\cards.live.json" Link="Data\cards.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <None Include="$(BotDataRoot)\card-effects.json" Link="Data\card-effects.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <!-- Blueprint 字节码 IR：由 tools/gen-kismet-ir.py 生成，Kismet 解释器直接执行它。
         这是效果编排层的真正来源（覆盖 1636 张有蓝图的卡）。 -->
    <None Include="$(BotDataRoot)\card-ir.json" Link="Data\card-ir.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <None Include="$(BotDataRoot)\card-vectors.json" Link="Data\card-vectors.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(BotDataRoot)\event-contracts.json" Link="Data\event-contracts.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <!-- 真实对局的线路动作（tools/extract-live-actions.py 从 fyserver 日志抽出）。
         用于校验协议理解；将来接逐帧状态对拍。 -->
    <None Include="$(BotDataRoot)\live-actions.json" Link="Data\live-actions.json"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(BotDataRoot)\live-actions.json')" />

    <!-- 真实对局回放（fyserver 只读接口导出）：开局快照 + 全部动作。
         内核验证的主素材，见 tools/decode-replay.py 与 src/KLink.Bot/Replay/。 -->
    <None Include="$(BotDataRoot)\live-replays\*.json" Link="Data\live-replays\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(BotDataRoot)\live-replays')" />

    <!-- 卡组码表：优先用线上 pak 解出的权威版本（tools/convert-deckcode-table.py 生成），
         比 Assets/kards-server/deck_code_ids.json 新（含 E*/D* 新卡）。 -->
    <None Include="$(BotDataRoot)\deck_code_ids.live.json" Link="Data\deck_code_ids.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
